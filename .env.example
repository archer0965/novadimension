# fal.ai — required for real AI generation
FAL_KEY=
# Optional model override (default: fal-ai/flux/dev/image-to-image)
FAL_MODEL=
# Img2img strength 0–1 (default 0.55, lower = keep more structure)
FAL_STRENGTH=0.55
# Allow mock output when FAL_KEY is missing (also on in non-production)
ALLOW_GENERATE_MOCK=1

# Existing
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
NEXT_PUBLIC_NOVAOS_URL=https://paycheck.com.de
NEXT_PUBLIC_PARENT_SITE_URL=https://paycheck.com.de
